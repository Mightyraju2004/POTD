class Solution {
public:
    int missingInteger(vector<int>& nums) {
        int n = nums.size();
        unordered_set<int>st(begin(nums),end(nums));//o(n)
        int seq_sum=nums[0];
        for(int j=1;j<n;j++){//o(n)
            if(nums[j]==nums[j-1]+1) seq_sum+=nums[j];
            else break;
        }

        while(st.find(seq_sum)!=st.end()){/o(n)
            seq_sum++;
        }
        return seq_sum;
    }
};
