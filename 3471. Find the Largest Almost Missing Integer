//ime Complexity O(N*K) 
//Space Complexity O(N) + O(k) = O(N)
//in sliding window hum j ko peeche nahi laate kabhi,peeche laane se vo brute force bn jaata hai
class Solution {
public:
    int largestInteger(vector<int>& nums, int k) {
        int n = nums.size();
        int i=0,j=0;
        unordered_map<int,int>mp;
        unordered_set<int>st;
        while(j<n){

            if(j-i+1==k){
                for(int l=i;l<=j;l++) st.insert(nums[l]);
                for(int x:st) mp[x]++;
                st.erase(nums[i]);//shifting the window
                i++;//shifting the window
            }

            j++;
        }
        
        int ans = -1;
        for(auto it:mp){
            if(it.second==1) ans=max(ans,it.first);
        }
        return ans;
    }
};
