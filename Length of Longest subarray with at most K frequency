//T.C=o(2n).every element is visited twice in worst case(Total elements are n)
//S.C=o(n).(unordered_map)
class Solution {
public:
    int maxSubarrayLength(vector<int>& nums, int k) {
        int n = nums.size();
        unordered_map<int,int>mp;
        int i=0;
        int j=0;
        int maxi=0;
        while(j<n){
            mp[nums[j]]++;
            while(i<j && mp[nums[j]]>k){
               mp[nums[i]]--;
               i++;
            }
            maxi=max(maxi,j-i+1);
            j++;
        }
        return maxi;
    }
};
